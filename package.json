{
    "name": "zeronium-cli",
    "version": "0.1.0",
    "description": "A CLI tool for managing all your development projects",
    "license": "MIT",
    "bin": {
        "zero": "src/index.ts",
        "zeronium-cli": "src/index.ts"
    },
    "module": "index.ts",
    "type": "module",
    "private": false,
    "scripts": {
        "dev": "bun run src/index.ts",
        "db:generate": "bunx drizzle-kit generate",
        "db:migrate": "bunx drizzle-kit migrate",
        "db:push": "bunx drizzle-kit push",
        "postinstall": "node scripts/jump-function-setup.js"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "drizzle-kit": "^0.31.8"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "commander": "^14.0.3",
        "drizzle-orm": "^0.45.1"
    }
}
