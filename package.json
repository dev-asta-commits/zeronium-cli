{
    "name": "zeronium-cli",
    "version": "0.2.8",
    "description": "A CLI tool for managing all your development projects",
    "license": "MIT",
    "bin": {
        "zero-dev": "src/index.ts",
        "zeronium-cli": "src/index.ts"
    },
    "module": "index.ts",
    "type": "module",
    "private": false,
    "scripts": {
        "dev": "bun run src/index.ts",
        "db:generate": "bunx drizzle-kit generate",
        "db:migrate": "bunx drizzle-kit migrate",
        "db:push": "bunx drizzle-kit push",
        "postinstall": "echo 'Runnin postinstall script' && node scripts/jump-function-setup.js"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "drizzle-kit": "^0.31.8"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "commander": "^14.0.3",
        "drizzle-orm": "^0.45.1"
    },
    "optionalDependencies": {
        "@zeronium/zeronium-cli-darwin-arm64": "0.2.7",
        "@zeronium/zeronium-cli-darwin-x64": "0.2.7",
        "@zeronium/zeronium-cli-lin-x64": "0.2.7",
        "@zeronium/zeronium-cli-win-x64": "0.2.7"
    }
}
